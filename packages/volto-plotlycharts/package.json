{
  "name": "@eeacms/volto-plotlycharts",
  "version": "14.0.7",
  "description": "Plotly Charts and Editor integration for Volto",
  "main": "src/index.js",
  "author": "European Environment Agency: IDM2 A-Team",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "homepage": "https://github.com/eea/volto-plotlycharts",
  "keywords": [
    "volto-addon",
    "volto-block",
    "volto-plotlychart",
    "volto",
    "plone",
    "react",
    "plotly"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:eea/volto-plotlycharts.git"
  },
  "addons": [
    "@eeacms/volto-embed",
    "@eeacms/volto-matomo",
    "@eeacms/volto-datablocks"
  ],
  "dependencies": {
    "@eeacms/react-chart-editor": "0.47.8",
    "@eeacms/volto-datablocks": "*",
    "@eeacms/volto-embed": "*",
    "@eeacms/volto-matomo": "*",
    "handsontable": "^15.2.0",
    "jsoneditor": "10.2.0",
    "jszip": "3.10.1",
    "plotly-icons": "^1.3.15",
    "plotly.js": "^2.35.3",
    "qs": "^6.14.2",
    "react-plotly.js": "2.6.0",
    "remixicon": "4.6.0",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.10.0",
    "@plone/scripts": "workspace:*",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-istanbul": "3.2.7",
    "babel-plugin-transform-class-properties": "^6.24.1",
    "cypress": "13.1.0",
    "dotenv": "^16.3.2",
    "husky": "^8.0.3",
    "jsdom": "23.0.0",
    "lint-staged": "^14.0.1",
    "md5": "^2.3.0",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "@plone/registry": "workspace:*",
    "@plone/types": "workspace:*",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "redux-mock-store": "1.5.4",
    "redux-thunk": "^2.4.2",
    "release-it": "^19.0.5",
    "typescript": "^5.7.3"
  },
  "resolutions": {
    "moment": "<=2.29.4"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json}": [
      "make lint-fix",
      "make prettier-fix"
    ],
    "src/**/*.{jsx}": [
      "make i18n"
    ],
    "theme/**/*.{css,less}": [
      "make stylelint-fix"
    ],
    "src/**/*.{css,less}": [
      "make stylelint-fix"
    ],
    "theme/**/*.overrides": [
      "make stylelint-fix"
    ],
    "src/**/*.overrides": [
      "make stylelint-fix"
    ]
  },
  "scripts": {
    "release": "release-it",
    "release-major-beta": "release-it major --preRelease=beta",
    "release-beta": "release-it --preRelease=beta",
    "test": "vitest --config ./vitest.config.mjs run --passWithNoTests",
    "test:fix": "vitest --config ./vitest.config.mjs run --passWithNoTests --update",
    "i18n": "rm -rf build/messages && NODE_ENV=production i18n --addon",
    "prepare": "cd ../.. && husky install || true",
    "dry-release": "release-it --dry-run",
    "release-major-alpha": "release-it major --preRelease=alpha",
    "release-alpha": "release-it --preRelease=alpha"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
