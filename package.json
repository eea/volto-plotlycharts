{
  "name": "@eeacms/volto-plotlycharts",
  "version": "14.0.7",
  "description": "Plotly Charts and Editor integration for Volto",
  "main": "src/index.js",
  "author": "European Environment Agency: IDM2 A-Team",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "homepage": "https://github.com/eea/volto-plotlycharts",
  "keywords": [
    "volto-addon",
    "volto-block",
    "volto-plotlychart",
    "volto",
    "plone",
    "react",
    "plotly"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:eea/volto-plotlycharts.git"
  },
  "addons": [
    "@eeacms/volto-embed",
    "@eeacms/volto-matomo",
    "@eeacms/volto-datablocks"
  ],
  "dependencies": {
    "@eeacms/react-chart-editor": "0.47.8",
    "@eeacms/volto-datablocks": "*",
    "@eeacms/volto-embed": "*",
    "@eeacms/volto-matomo": "*",
    "@plone/scripts": "^3.10.6",
    "handsontable": "^15.2.0",
    "jsoneditor": "10.2.0",
    "jszip": "3.10.1",
    "plotly-icons": "^1.3.15",
    "plotly.js": "^2.35.3",
    "qs": "^6.14.2",
    "react-plotly.js": "2.6.0",
    "remixicon": "4.6.0",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^3.10.0",
    "@plone/scripts": "^3.10.6",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "babel-plugin-transform-class-properties": "^6.24.1",
    "cypress": "13.1.0",
    "dotenv": "^16.3.2",
    "husky": "^8.0.3",
    "jsdom": "23.0.0",
    "lint-staged": "^14.0.1",
    "md5": "^2.3.0",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "resolutions": {
    "moment": "<=2.29.4"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json}": [
      "make lint-fix",
      "make prettier-fix"
    ],
    "src/**/*.{jsx}": [
      "make i18n"
    ],
    "theme/**/*.{css,less}": [
      "make stylelint-fix"
    ],
    "src/**/*.{css,less}": [
      "make stylelint-fix"
    ],
    "theme/**/*.overrides": [
      "make stylelint-fix"
    ],
    "src/**/*.overrides": [
      "make stylelint-fix"
    ]
  },
  "scripts": {
    "release": "release-it",
    "release-major-beta": "release-it major --preRelease=beta",
    "release-beta": "release-it --preRelease=beta",
    "bootstrap": "npm install -g ejs; npm link ejs; node bootstrap",
    "test": "vitest --config ./vitest.config.mjs run --passWithNoTests",
    "test:fix": "vitest --config ./vitest.config.mjs run --passWithNoTests --update",
    "pre-commit": "pnpm stylelint:fix && pnpm prettier:fix && pnpm lint:fix",
    "stylelint": "make stylelint",
    "stylelint:overrides": "make stylelint-overrides",
    "stylelint:fix": "make stylelint-fix",
    "prettier": "make prettier",
    "prettier:fix": "make prettier-fix",
    "lint": "make lint",
    "lint:fix": "make lint-fix",
    "i18n": "make i18n",
    "cypress:run": "make cypress-run",
    "cypress:open": "make cypress-open",
    "prepare": "husky install"
  }
}
